--- a/util/qemu-timer.c	2026-10-15 05:26:52.688549814 +0000
+++ b/util/qemu-timer.c	2026-10-15 05:30:21.353950293 +0000
@@ -351,6 +351,69 @@
         return ppoll((struct pollfd *)fds, nfds, &ts, NULL);
     }
 #else
+    /*
+     * No ppoll (macOS): g_poll has millisecond resolution, so every timer
+     * due in under 1 ms fires >= 1 ms late, and device models with
+     * microsecond delays (nano7 I2C bytes, NAND, DMA) run up to 50x slow
+     * against guest time. select() takes a microsecond timeout and, unlike
+     * a sleep, still wakes on the fds (QEMU's notifier: a vCPU arming a
+     * new, nearer timer).
+     */
+    if (timeout >= 0 && timeout < 10 * SCALE_MS) {
+        fd_set rd, wr, ex;
+        struct timeval tv = {
+            .tv_sec = 0,
+            .tv_usec = (timeout + SCALE_US - 1) / SCALE_US,
+        };
+        int maxfd = -1, ret;
+        guint i;
+
+        FD_ZERO(&rd);
+        FD_ZERO(&wr);
+        FD_ZERO(&ex);
+        for (i = 0; i < nfds; i++) {
+            if (fds[i].fd < 0 || fds[i].fd >= FD_SETSIZE) {
+                goto fallback;
+            }
+            if (fds[i].events & (G_IO_IN | G_IO_HUP | G_IO_ERR)) {
+                FD_SET(fds[i].fd, &rd);
+            }
+            if (fds[i].events & G_IO_OUT) {
+                FD_SET(fds[i].fd, &wr);
+            }
+            if (fds[i].events & G_IO_PRI) {
+                FD_SET(fds[i].fd, &ex);
+            }
+            maxfd = MAX(maxfd, fds[i].fd);
+        }
+        ret = select(maxfd + 1, &rd, &wr, &ex, &tv);
+        if (ret <= 0) {
+            return ret;
+        }
+        ret = 0;
+        for (i = 0; i < nfds; i++) {
+            fds[i].revents = 0;
+            if (fds[i].fd < 0) {
+                continue;
+            }
+            if (FD_ISSET(fds[i].fd, &rd)) {
+                fds[i].revents |= fds[i].events & (G_IO_IN | G_IO_HUP |
+                                                   G_IO_ERR);
+                if (!fds[i].revents) {
+                    fds[i].revents = G_IO_IN;
+                }
+            }
+            if (FD_ISSET(fds[i].fd, &wr)) {
+                fds[i].revents |= G_IO_OUT;
+            }
+            if (FD_ISSET(fds[i].fd, &ex)) {
+                fds[i].revents |= G_IO_PRI;
+            }
+            ret += fds[i].revents != 0;
+        }
+        return ret;
+    }
+fallback:
     return g_poll(fds, nfds, qemu_timeout_ns_to_ms(timeout));
 #endif
 }
